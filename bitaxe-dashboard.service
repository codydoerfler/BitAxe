# LEGACY — Raspberry Pi systemd unit. The dashboard now runs on the Mac mini
# via a launchd LaunchAgent; see "Install Dashboard Autostart.command" and
# com.doerfler.bitaxe-dashboard.plist. Kept for reference only.
[Unit]
Description=BitAxe Dashboard
After=network.target

[Service]
ExecStart=/usr/bin/python3 /home/pi/bitaxe/server.py
WorkingDirectory=/home/pi/bitaxe
Restart=always
User=pi

[Install]
WantedBy=multi-user.target
